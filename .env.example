# Copy to .env and fill in. Never commit .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained once through the setup flow (YT2POD_SETUP_ENABLED=true, see docs/tech-spec.md section 3)
GOOGLE_REFRESH_TOKEN=
YT2POD_SETUP_ENABLED=false

# Optional (defaults shown)
# YT2POD_DRIVE_FOLDER_NAME=yt2pod
# YT2POD_AUDIO_FORMAT=m4a
# YT2POD_AUDIO_BITRATE=64K
# YT2POD_AUDIO_MONO=true
# YT2POD_JOBS_MAX_CONCURRENT=2
# YT2POD_JOBS_TTL=1h
# YT2POD_LIMITS_MAX_DURATION=3h
